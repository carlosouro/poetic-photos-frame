# Google AI Studio API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=YOUR_KEY_HERE

# Local mount point of NAS photo library (/mnt/nas/photos on Pi, /Volumes/photo on macOS)
NAS_ROOT_PATH=/Volumes/photo

# Express server port
PORT=3000

# Gemini Vision Model
GEMINI_MODEL=gemini-flash-latest

# Display & Timing Defaults (Waveshare 10.1" 1280x800 LCD)
FRAME_SCREEN_WIDTH=1280
FRAME_SCREEN_HEIGHT=800
SLIDESHOW_INTERVAL_SECONDS=20
MAX_VIDEO_DURATION_SECONDS=20
PREWARM_QUEUE_SIZE=3

# Media Size Guardrails
MAX_VIDEO_SIZE_MB=50
MAX_IMAGE_SIZE_MB=25

# Cache Directories
VIDEO_CACHE_DIR=./cache/transcoded
IMAGE_CACHE_DIR=./cache/images

# Weather Widget Configuration (Open-Meteo, no API key required)
WEATHER_LOCATION="Santarem, Portugal"
WEATHER_LATITUDE=39.2338
WEATHER_LONGITUDE=-8.6862
WEATHER_TIMEZONE=Europe/Lisbon
