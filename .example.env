# Get this key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_KEY_HERE

# Path to where your indexer script will save the list
PHOTOS_JSON_PATH=./photos.json

NAS_ROOT_PATH=/Volumes/photo

# Port for the web server
PORT=3000

GEMINI_MODEL=gemini-2.5-flash

# Weather Widget Configuration (Open-Meteo)
WEATHER_LOCATION="Santarem, Portugal"
WEATHER_LATITUDE=39.2338
WEATHER_LONGITUDE=-8.6862
WEATHER_TIMEZONE=Europe/Lisbon